    {
        "id": "81369a09899275d9",
        "type": "function",
        "z": "7010ea5366f70a3f",
        "name": "noti",
        "func": "if (msg.payload && typeof msg.payload === 'string') {\n    // Kiểm tra nếu payload bắt đầu bằng số 1\n    if (msg.payload.startsWith('4 ')) {\n        // Lấy toàn bộ chuỗi sau số 1 và khoảng trắng\n        msg.payload = msg.payload.substring(2).trim(); // Bỏ số 1 và khoảng trắng\n    } else {\n       return;\n    }\n} else {\n    return;\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 680,
