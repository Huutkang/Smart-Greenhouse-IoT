    {
        "id": "39a1264cf4270829",
        "type": "function",
        "z": "7010ea5366f70a3f",
        "name": "lưu thời gian",
        "func": "flow.set(\"userInput\", msg.payload);\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
