        "type": "function",
        "z": "7010ea5366f70a3f",
        "name": "function 0",
        "func": "const payloadStr = String(msg.payload).trim();\nif (payloadStr[0] === '1') {\n    msg.payload = \"bật\";\n} else {\n    msg.payload = \"tắt\";\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
