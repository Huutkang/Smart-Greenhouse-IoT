        "id": "17c017d4821feadc",
        "type": "function",
        "z": "0c792c6756b4faba",
        "name": "noti",
        "func": "if (msg.payload && typeof msg.payload === 'string') {\n    // Kiểm tra nếu payload bắt đầu bằng số 1\n    if (msg.payload.startsWith('3 ')) {\n        // Lấy toàn bộ chuỗi sau số 1 và khoảng trắng\n        msg.payload = msg.payload.substring(2).trim(); // Bỏ số 1 và khoảng trắng\n    } else {\n       return;\n    }\n} else {\n    return;\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
