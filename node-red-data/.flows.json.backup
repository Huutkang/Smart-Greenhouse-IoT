    {
        "id": "fc52809984a2cb27",
        "type": "function",
        "z": "0c792c6756b4faba",
        "name": "tính mes",
        "func": "// Lấy dữ liệu đã lưu trong context\nconst userInput = flow.get(\"userInput\");\n\nif (!userInput) {\n    // Nếu chưa có dữ liệu input, thông báo lỗi\n    return { payload: \"Không có dữ liệu để gửi!\" };\n}\nconst timer =  userInput / 1000 % (24*3600);\nmsg.payload = '31 '+timer;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 260,
