    {
        "id": "833e8ce8b9d6a9ef",
        "type": "function",
        "z": "7010ea5366f70a3f",
        "name": "tính mes",
        "func": "const userInput = flow.get(\"userInput\");\n\nif (!userInput) {\n    return { payload: \"Không có dữ liệu để gửi!\" };\n}\nif (userInput > 100 || userInput < 0) {\n    return { payload: \"Dữ liệu nhập không hợp lệ!\" };\n}\nmsg.payload = userInput;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
