    {
        "id": "65b43ab4ca9d1d91",
        "type": "function",
        "z": "0c792c6756b4faba",
        "name": "lưu thời gian",
        "func": "// Lưu giá trị input vào context flow\nflow.set(\"userInput\", msg.payload);\nreturn null; // Không gửi gì tiếp tục từ đây\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
