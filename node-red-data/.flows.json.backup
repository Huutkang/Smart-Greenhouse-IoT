        "type": "function",
        "z": "7010ea5366f70a3f",
        "name": "Đổi màu button",
        "func": "if (msg.payload === \"send\"){\n    msg.auto = '';\n    msg.on = '';\n    msg.off = '';\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
