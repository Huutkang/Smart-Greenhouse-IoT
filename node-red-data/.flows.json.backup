    },
    {
        "id": "fbfe98e07caa9e3d",
        "type": "function",
        "z": "7010ea5366f70a3f",
        "name": "tính mes",
        "func": "// Lấy dữ liệu đã lưu trong context\nconst userInput = flow.get(\"userInput\");\n\nif (!userInput) {\n    // Nếu chưa có dữ liệu input, thông báo lỗi\n    return { payload: \"Không có dữ liệu để gửi!\" };\n}\nconst timer =  userInput / 1000 % (24*3600);\nmsg.payload = '01 '+timer;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 240,
        "wires": [
            [
                "e9121db529da3f69"
            ]
        ]
    },
