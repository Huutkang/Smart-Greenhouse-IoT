    {
        "id": "dd6eec7c7fbaa0a5",
        "type": "function",
        "z": "7010ea5366f70a3f",
        "name": "Đổi màu button",
        "func": "const color = 'green'\nif (msg.payload === \"AUTO4\"){\n    msg.auto = color;\n    msg.on = '';\n    msg.off = '';\n    msg.timer1 = color;\n    msg.timer2 = color;\n    msg.timer3 = color;\n    msg.timer4 = color;\n} else if (msg.payload === \"ON4\") {\n    msg.auto = '';\n    msg.on = color;\n    msg.off = '';\n    msg.timer1 = color;\n    msg.timer2 = color;\n    msg.timer3 = color;\n    msg.timer4 = color;\n} else if (msg.payload === \"OFF4\") {\n    msg.auto = '';\n    msg.on = '';\n    msg.off = color;\n    msg.timer1 = color;\n    msg.timer2 = color;\n    msg.timer3 = color;\n    msg.timer4 = color;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 540,
        "wires": [
            [
                "b1ae9358dce3e045",
                "6923363c0ca44bc3",
                "598304f0ab99c84b",
                "6fbfba35bfe9aa7a",
