    {
        "id": "cb922ae47e1152a1",
        "type": "function",
        "z": "0c792c6756b4faba",
        "name": "Đổi màu button",
        "func": "const color = 'green'\nif (msg.payload === \"AUTO3\"){\n    msg.auto = color;\n    msg.on = '';\n    msg.off = '';\n    msg.timer1 = color;\n    msg.timer2 = color;\n    msg.timer3 = color;\n    msg.timer4 = color;\n} else if (msg.payload === \"ON3\") {\n    msg.auto = '';\n    msg.on = color;\n    msg.off = '';\n    msg.timer1 = color;\n    msg.timer2 = color;\n    msg.timer3 = color;\n    msg.timer4 = color;\n} else if (msg.payload === \"OFF3\") {\n    msg.auto = '';\n    msg.on = '';\n    msg.off = color;\n    msg.timer1 = color;\n    msg.timer2 = color;\n    msg.timer3 = color;\n    msg.timer4 = color;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 560,
        "wires": [
